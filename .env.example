# API key for Google Gemini Pro. This is required for the agent to function.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# API key for SerpApi (serpapi.com). This is optional.
# It is used by the web_searcher tool to check for brand conflicts.
# If you leave this empty, the agent will skip the web search step.
SERPAPI_API_KEY="YOUR_SERPAPI_API_KEY_HERE"
